#!/usr/local/bin/dyalogscript ENABLE_CEF=0 DYALOG_INITSESSION=1
⍝ APL Othello: a raylibAPL front-end to the engine in src/. Run from the project root: ./ui/othello.apls
⍝ Click to move. N new game, U undo, S swap sides, H hints, + / - engine time, Esc quit.
⎕IO←0
root←⊃1⎕NPARTS''
z←⎕SE.Link.Import '#.O' (root,'src')
rlDir←root,'vendor/raylibAPL/link/'
rl←0⎕Fix rlDir,'raylib.apln'
rl.Init rlDir

⍝ layout (pixels) and palette (RGBA)
S←80 ⋄ X0←56 ⋄ Y0←110 ⋄ W←X0+X0+8×S ⋄ H←Y0+8×S+140
bg←28 32 38 255 ⋄ frame←12 74 48 255 ⋄ felt←18 124 80 255 ⋄ grid←10 86 54 255
blk←24 24 26 255 ⋄ wht←240 240 234 255 ⋄ shade←0 0 0 70 ⋄ hint←255 255 255 60
mark←236 92 72 255 ⋄ txt←226 229 233 255 ⋄ dim←140 148 158 255 ⋄ gold←246 196 82 255

Cell←{r f←8 8⊤⍵ ⋄ ⌊(X0+S×f+0.5),Y0+S×7.5-r}                          ⍝ pixel centre of square ⍵
Under←{x y←⌊(⍵-X0 Y0)÷S ⋄ (x∊⍳8)∧y∊⍳8:8⊥(7-y)x ⋄ ¯1}                 ⍝ square under pixel ⍵, or ¯1
Disc←{x y←Cell ⍺ ⋄ r←⌊S×0.4 ⋄ z←rl.DrawCircle(x+3)(y+4)r shade ⋄ rl.DrawCircle x y r ⍵}
Text←{x y s c←⍺ ⋄ rl.DrawText ⍵ x y s c}
Mid←{s y c←⍺ ⋄ ((⌊(W-rl.MeasureText ⍵ s)÷2)y s c)Text ⍵}               ⍝ centred text
Pawn←{x y c n←⍵ ⋄ z←rl.DrawCircle x y 15 c ⋄ z←rl.DrawCircleLines x y 15 dim ⋄ ((x+26)(y-13)28 txt)Text⍕n}
Who←{⍵⊃'Black' 'White'}
Num←{((⍵<0)⊃'+-'),2⍕|⍵÷100}                                          ⍝ centidiscs as signed discs

Final←{ ⍝ finished game ⍵ → 'White wins 60-3' (WTHOR margin noted when empty squares count)
    c b←⍵ ⋄ n←+/⊖⍣c⊢b ⋄ m←O.Result ⍵ ⋄ t←(⍕⌈/n),'-',⍕⌊/n
    m=0:'a draw, ',t
    w←(Who m<0),' wins ',t ⋄ (|m)=|-/n:w ⋄ w,' (',(⍕|m),' with the empty squares)'
}

Board←{
    z←rl.DrawRectangle(X0-12)(Y0-12)(24+8×S)(24+8×S)frame
    z←rl.DrawRectangle X0 Y0(8×S)(8×S)felt
    z←{rl.DrawLine(X0+S×⍵)Y0(X0+S×⍵)(Y0+8×S)grid}¨⍳9
    z←{rl.DrawLine X0(Y0+S×⍵)(X0+8×S)(Y0+S×⍵)grid}¨⍳9
    z←{rl.DrawCircle(X0+S×⊃⍵)(Y0+S×1⊃⍵)5 grid}¨2 6∘.,2 6
    z←{((⌊X0+S×⍵+0.42)(Y0-38)20 dim)Text,⍵⊃'abcdefgh'}¨⍳8
    z←{((X0-38)(⌊Y0+S×⍵+0.38)20 dim)Text ⍕8-⍵}¨⍳8
    0
}

Status←{ ⍝ game ⍵ → headline
    c b←⍵
    O.Terminal b:'Game over: ',Final ⍵
    ~∨/O.Moves b:(Who c),' has no move and passes'
    c≠hc:'Engine is thinking...'
    'Your move (',(Who c),')'
}

Info←{ ⍝ last engine search result ⍵ → one line
    0=≢⍵:'Engine plays ',(Who~hc),', ',(⍕ms÷1000),' s per move'
    s v d n st so←⍵
    so:'Engine played ',(O.Name s),': solved, ',{⍵=0:'draws' ⋄ ((⍵>0)⊃'loses' 'wins'),' by ',⍕|⍵÷100}v
    'Engine played ',(O.Name s),': depth ',(⍕d),', eval ',(Num v),', ',(⍕n),' nodes'
}

G←0 O.Start ⋄ hist←⍬ ⋄ hc←0 ⋄ ms←2000 ⋄ hints←1 ⋄ lm←¯1 ⋄ last←⍬ ⋄ pend←0 ⋄ pc←0
K←rl.KeyboardKey ⋄ LMB←rl.MouseButton.MOUSE_BUTTON_LEFT

rl.InitWindow W H 'APL Othello'
:While ~rl.WindowShouldClose⍬
    c b←G ⋄ mv←⍸O.Moves b ⋄ over←O.Terminal b ⋄ sq←Under rl.GetMousePosition⍬

    ⍝ input
    :If rl.IsKeyPressed K.KEY_N ⋄ G←0 O.Start ⋄ hist←⍬ ⋄ lm←¯1 ⋄ last←⍬ ⋄ pend←0 ⋄ :Continue ⋄ :EndIf
    :If rl.IsKeyPressed K.KEY_H ⋄ hints←~hints ⋄ :EndIf
    :If rl.IsKeyPressed K.KEY_S ⋄ hc←~hc ⋄ pend←0 ⋄ :EndIf
    :If rl.IsKeyPressed K.KEY_EQUAL ⋄ ms←16000⌊ms×2 ⋄ :EndIf
    :If rl.IsKeyPressed K.KEY_MINUS ⋄ ms←250⌈ms÷2 ⋄ :EndIf
    :If (rl.IsKeyPressed K.KEY_U)∧0<≢hist
        :Repeat ⋄ G lm←⊃⌽hist ⋄ hist←¯1↓hist ⋄ :Until (hc=⊃G)∨0=≢hist
        pend←0 ⋄ last←⍬ ⋄ :Continue
    :EndIf

    ⍝ play
    :If ~over
        :If 0=≢mv                                 ⍝ forced pass: show it for a moment
            pc+←1
            :If pc>60 ⋄ hist,←⊂G lm ⋄ G←(~c)(⊖b) ⋄ pc←0 ⋄ :EndIf
        :ElseIf c=hc
            :If (rl.IsMouseButtonPressed LMB)∧sq∊mv
                hist,←⊂G lm ⋄ G←(~c)(sq O.Play b) ⋄ lm←sq
            :EndIf
        :ElseIf pend                              ⍝ the "thinking" frame has been shown: search now
            last←ms O.Think b ⋄ hist,←⊂G lm ⋄ lm←⊃last ⋄ G←(~c)(lm O.Play b) ⋄ pend←0
        :Else
            pend←1
        :EndIf
    :EndIf

    ⍝ draw
    c b←G ⋄ mv←⍸O.Moves b ⋄ k←⊖⍣c⊢b
    rl.BeginDrawing⍬
    rl.ClearBackground bg
    z←(24 10 txt)Mid'APL Othello'
    z←Pawn 56 44 blk(+/k[0;]) ⋄ z←Pawn(W-120)44 wht(+/k[1;])
    :If ~O.Terminal b ⋄ z←rl.DrawRectangle(c⊃40(W-136))64 100 4 gold ⋄ :EndIf  ⍝ side to move
    z←Board 0
    z←{⍵ Disc blk}¨⍸k[0;] ⋄ z←{⍵ Disc wht}¨⍸k[1;]
    :If (c=hc)∧~O.Terminal b
        :If hints ⋄ z←{x y←Cell ⍵ ⋄ rl.DrawCircle x y 7 hint}¨mv ⋄ :EndIf
        :If sq∊mv ⋄ z←sq Disc(3↑c⊃blk wht),110 ⋄ :EndIf
    :EndIf
    :If lm≥0 ⋄ x y←Cell lm ⋄ z←rl.DrawCircle x y 6 mark ⋄ :EndIf
    :If O.Terminal b                              ⍝ game-over banner across the board
        z←rl.DrawRectangle X0(Y0+3×S)(8×S)(2×S)(16 18 22 215)
        z←(40(⌊Y0+S×3.35)gold)Mid'Game over'
        z←(24(⌊Y0+S×4.15)txt)Mid Final G
        z←(16(⌊Y0+S×4.6)dim)Mid'press N for a new game'
    :EndIf
    z←(24(Y0+8×S+34)txt)Mid Status G
    z←(18(Y0+8×S+70)dim)Mid Info last
    z←(16(Y0+8×S+104)dim)Mid'click: move   N new   U undo   S swap sides   H hints   +/- engine time   Esc quit'
    rl.EndDrawing⍬
:EndWhile
rl.CloseWindow⍬
